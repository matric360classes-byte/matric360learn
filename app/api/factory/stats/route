import { NextResponse } from "next/server";
import { createClient } from "@supabase/supabase-js";
const supabase = createClient(process.env.NEXT_PUBLIC_SUPABASE_URL!, process.env.SUPABASE_SERVICE_ROLE_KEY!);
export async function GET(){
  const { data } = await supabase.from("lesson_previews").select("status");
  const queued = data?.filter((d:any)=>d.status==="queued").length||0;
  const ready = data?.filter((d:any)=>d.status==="ready").length||0;
  const failed = data?.filter((d:any)=>d.status==="failed").length||0;
  return NextResponse.json({queued, ready, failed});
}
